<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ScrollBase.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ScrollBase"
    xmlns:views="clr-namespace:ScrollBase.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="ScrollBase">

    <FlyoutItem Title="main menu">
        <Tab Title="login">
            <ShellContent
             Title="Login"
             ContentTemplate="{DataTemplate views:Login}"
             Route="Login"/>
        </Tab>

        <Tab Title="signup">
            <ShellContent
             Title="Signup"
             ContentTemplate="{DataTemplate views:Signup}"
             Route="Signup"/>    
        </Tab>

        <Tab Title="add page">
            <ShellContent
             Title="Add Page"
             ContentTemplate="{DataTemplate views:AddWebPage}"
             Route="Signup"/>   
        </Tab>

        <!--<Tab Title="userlist">
            <ShellContent
             Title="AppUserList"
             ContentTemplate="{DataTemplate views:AppUserList}"
             Route="AppUserList"/>   
        </Tab>-->
    </FlyoutItem>

    <!--<ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />-->

</Shell>
