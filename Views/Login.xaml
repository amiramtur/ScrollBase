<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScrollBase.ViewModels"
             xmlns:controls="clr-namespace:ScrollBase.Controls"
             x:DataType="vm:LoginVM"
             x:Class="ScrollBase.Views.Login"
             Title="Login">

    <VerticalStackLayout>

        <Entry x:Name="EmailEntry" Placeholder="email" Text="{Binding Email}" HorizontalTextAlignment="End"/>
        <Entry x:Name="PasswordEntry" Placeholder="password" Text="{Binding Password}" HorizontalTextAlignment="End" IsPassword="True"/>
        <Button Text="Login" BackgroundColor="LawnGreen" Command="{Binding LoginCommand}"/>

        <controls:NetworkRetryOverlay />
    </VerticalStackLayout>
</ContentPage>