<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ScrollBase.ViewModels"
             x:DataType="vm:AddWebPageVM"
             x:Class="ScrollBase.Views.AddWebPage"
             Title="AddWebPage">
    
    <VerticalStackLayout>
        <Entry x:Name="NameEntry" Placeholder="title" Text="{Binding Name}" HorizontalTextAlignment="End"/>
        <Entry x:Name="LinkEntry" Placeholder="link" Text="{Binding Link}" HorizontalTextAlignment="End"/>
        <!-- give the button a name so code-behind can attach a quick debug hook -->
        <Button x:Name="AddButton" Text="Add page" BackgroundColor="LawnGreen" Command="{Binding AddPageCommand}"/>
    </VerticalStackLayout>
</ContentPage>