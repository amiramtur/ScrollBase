<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ScrollBase.MainPage">

    <Grid Padding="30,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Label Grid.Row="0" Text="ScrollBase" FontSize="30" HorizontalTextAlignment="Center"/>
        
        <Grid Grid.Row="1" Padding="30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--<Button Grid.Row="0" Grid.Column="3" Text="Login" Clicked="LoadLogin"></Button>-->
        </Grid>
        

        
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="25">
                <Label Text="POST" FontSize="170" HorizontalTextAlignment="Center"/>
                <Label Text="POST" FontSize="170" HorizontalTextAlignment="Center"/>
                <Label Text="POST" FontSize="170" HorizontalTextAlignment="Center"/>
                <Label Text="POST" FontSize="170" HorizontalTextAlignment="Center"/>
                <Label Text="POST" FontSize="170" HorizontalTextAlignment="Center"/>
                <Label Text="POST" FontSize="170" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3" Padding="30,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!--<Button Grid.Column="0" Text="saved" Clicked="LoadSaved"/>
            <Button Grid.Column="1" Text="home"/>
            <Button Grid.Column="2" Text="add" Clicked="LoadAdd"/>-->
        </Grid>
    </Grid>

</ContentPage>
